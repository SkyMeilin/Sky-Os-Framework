# ==============================================================================
# SkyOS & Agency Level Up - Sicherheitsrichtlinien Repository .gitignore
# ==============================================================================

# Node.js Dependencies & Logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python & Environment Virtualenvs
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# Environment Variables & Secret Files (Zero-IP-Leakage / Security)
.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# IDEs & System Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing & Coverage Outputs
.coverage
htmlcov/
.pytest_cache/
pytest-report.xml
junit-report.xml

# Local Model & Data Caches (LM Studio, Ollama)
models_cache/
.cache/

# Exceptions: Preserve empty directories via .gitkeep
!papers/.gitkeep
