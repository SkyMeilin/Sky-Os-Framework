# SkyOS Open Core - Environment Variables
# Agency Level Up 2025 (Pascal Weidermann, Hückelhoven)
#
# WICHTIG: Diese Datei NICHT in Git committen!
# Kopiere sie nach .env und fülle die Werte aus.

# Application
APP_NAME=SkyOS Open Core
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==============================================================================
# API Authentifizierung (erforderlich — kein Default-Fallback!)
# ==============================================================================

# Zentrale API-Key für alle SkyOS Server-Endpunkte
SKYOS_API_KEY=

# GitHub OAuth (erforderlich für Authentifizierung)
# Siehe: docs/github-oauth-setup.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# JWT Authentication
JWT_SECRET_KEY=skyos-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ==============================================================================
# Webhook Secrets (erforderlich für Payment-Gateway Signatur-Verifikation)
# ==============================================================================

# PayPal Webhook Secret (von PayPal Developer Dashboard)
PAYPAL_WEBHOOK_SECRET=

# Revolut Webhook Secret (von Revolut Business Dashboard)
REVOLUT_WEBHOOK_SECRET=

# SkyOS Master Nexus Webhook Signing Secret
SKYOS_WEBHOOK_SECRET=

# ==============================================================================
# WordPress Integration (optional — nur wenn Publishing aktiv)
# ==============================================================================

WORDPRESS_USER=
WORDPRESS_PASSWORD=

# ==============================================================================
# Discord Bot (optional — nur wenn Discord-Bot aktiv)
# ==============================================================================

DISCORD_BOT_TOKEN=

# Database (optional, für zukünftiges WORM-Ledger)
DATABASE_URL=

# OCR / Tesseract
TESSERACT_LANGUAGE=deu
TESSERACT_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
