<?xml version="1.0" encoding="UTF-8"?>
<module type="PYTHON_MODULE" version="4">
  <component name="NewModuleRootManager">
    <content url="file://$MODULE_DIR$">
      <!-- 1. Quellcode-Ordner (Source Roots) -->
      <sourceFolder url="file://$MODULE_DIR$/src" isTestSource="false" />
      <sourceFolder url="file://$MODULE_DIR$/backend_python" isTestSource="false" />

      <!-- 2. Test-Ordner als Test Source Root markieren (grün in PyCharm) -->
      <sourceFolder url="file://$MODULE_DIR$/tests" isTestSource="true" />

      <!-- 3. Schwere Ordner von der IDE-Indizierung ausschließen -->
      <excludeFolder url="file://$MODULE_DIR$/.venv" />
      <excludeFolder url="file://$MODULE_DIR$/node_modules" />
      <excludeFolder url="file://$MODULE_DIR$/build" />
      <excludeFolder url="file://$MODULE_DIR$/.pytest_cache" />
    </content>
    <orderEntry type="inheritedJdk" />
    <orderEntry type="sourceFolder" forTests="false" />
  </component>
